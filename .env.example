# Copy to .env and fill in. Do not commit .env.

# Web
HTTP_PORT=3000

# Database: sqlite3 or postgres
DB_DRIVER=sqlite3
DB_PATH=perimeter.db
# DB_DSN=postgres://user:pass@localhost/perimeter?sslmode=disable

# docker compose only: credentials for the bundled Postgres (defaults shown).
# DB_DRIVER/DB_DSN above are ignored under compose — it always uses Postgres.
# POSTGRES_USER=perimeter
# POSTGRES_PASSWORD=perimeter
# POSTGRES_DB=perimeter

# Scanning
WORKER_COUNT=3
PORT_INTERVAL=1h
SSL_INTERVAL=12h
CSP_INTERVAL=1h

# Dashboard: how close to expiry a certificate is flagged.
CERT_EXPIRY_WINDOW=720h
# TARGET_FILE: leave unset under docker compose — the file isn't in the image.
# TARGET_FILE=targets.lst

# SSL Labs registration (needed for SSL scans)
FIRST_NAME=
LAST_NAME=
EMAIL=
ORGANIZATION=

# Sessions
SESSION_MAX_AGE=720h

# OIDC login (optional)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=

# Require email confirmation on register
REQUIRE_CONFIRM=false
